# Copy to .env (repo root) and adjust. Used by docker-compose and the backend.

# --- Postgres (docker-compose) ---
POSTGRES_USER=housing
POSTGRES_PASSWORD=housing
POSTGRES_DB=housing
POSTGRES_PORT=5433

# --- Backend ---
DATABASE_URL=postgresql+psycopg://housing:housing@localhost:5433/housing
CORS_ORIGINS=http://localhost:5173
