# Copy to .env (repo root) and adjust. Used by docker-compose and the backend.

# --- Postgres (docker-compose) ---
POSTGRES_USER=housing
POSTGRES_PASSWORD=housing
POSTGRES_DB=housing
POSTGRES_PORT=5433

# --- Backend ---
DATABASE_URL=postgresql+psycopg://housing:housing@localhost:5433/housing
CORS_ORIGINS=http://localhost:5173

# --- tools/ri_housing_report (all optional) ---
# Gemini + Google Search grounding for budget lookup (--ai). Key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Free key: https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=
# Free token: https://www.huduser.gov/hudapi/public/register
HUD_API_TOKEN=
